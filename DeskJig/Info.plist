<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BentoWorktreeName</key>
	<string>$(BENTO_WORKTREE_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Frozen legacy scheme: existing installs, bentoctl and user
				     automation all deliver deep links as bento://… -->
				<string>bento</string>
			</array>
		</dict>
	</array>
	<key>NSAppleEventsUsageDescription</key>
	<string>DeskJig controls supported apps to restore workspace windows.</string>
	<key>NSApplicationCrashOnExceptions</key>
	<true/>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Taking preview of apps when creating workspace</string>
	<!-- Sparkle update feed.
	     The feed is a GitHub Release asset republished on every release, reached
	     through the `/releases/latest/download/` redirect so the URL is stable
	     forever (see docs/RELEASING.md for why this beats a gh-pages branch).

	     SUPublicEDKey is the PUBLIC half of the maintainer's EdDSA keypair,
	     generated 2026-08-25 with Sparkle's `generate_keys` on the Studio. The
	     private half lives only in the maintainer's login keychain and the
	     SPARKLE_PRIVATE_KEY GitHub Actions secret (export via
	     `generate_keys -x`, see docs/RELEASING.md §3). Rotating the keypair
	     means shipping one release signed by BOTH keys — never just swap this
	     value or existing installs will reject every future update. -->
	<key>SUFeedURL</key>
	<string>https://github.com/HumidResearch/deskjig/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>ppZ3hrOn/Pr4PJlza6HpdZAhqTm27D/QYY+ZFO7dBc0=</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Window Snapshot</string>
			<key>UTTypeIcons</key>
			<dict/>
			<key>UTTypeIdentifier</key>
			<string>com.nexus.windowsnapshot</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>windowsnapshot</string>
				</array>
			</dict>
		</dict>
		<dict/>
	</array>
</dict>
</plist>
